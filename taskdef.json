{
  "family": "blacklist-service",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "<TASK_EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<TASK_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "blacklist-service",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [{ "containerPort": 5000, "protocol": "tcp" }],
      "environment": [
        { "name": "RDS_HOSTNAME", "value": "<DB_HOST>" },
        { "name": "RDS_PORT", "value": "5432" },
        { "name": "RDS_DB_NAME", "value": "blacklist" }
      ],
      "secrets": [
        { "name": "STATIC_BEARER_TOKEN", "valueFrom": "<TOKEN_SECRET_ARN>" },
        { "name": "JWT_SECRET_KEY", "valueFrom": "<JWT_SECRET_ARN>" },
        { "name": "RDS_USERNAME", "valueFrom": "<DB_SECRET_ARN>:username::" },
        { "name": "RDS_PASSWORD", "valueFrom": "<DB_SECRET_ARN>:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blacklist-service",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
