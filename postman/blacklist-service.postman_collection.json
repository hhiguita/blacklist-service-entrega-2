{
  "info": {
    "_postman_id": "ac352a8f-7c43-40a9-bc25-4da25c4bf8ee",
    "name": "Blacklist Service - Entrega 2",
    "description": "Pruebas funcionales del microservicio de lista negra desplegado en Elastic Beanstalk. Seleccionar el entorno 'Blacklist Service - AWS' y definir token (STATIC_BEARER_TOKEN del entorno). Ejecutar en orden con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "GET / sin token. Es el health check de Beanstalk.",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 POST agregar email (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Email unico por ejecucion para que la coleccion sea re-ejecutable",
              "pm.collectionVariables.set('email', `prueba.${Date.now()}@ejemplo.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve el email agregado', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        },
        "description": "Agrega un email. El servicio guarda ademas la IP de origen y la fecha.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"app_uuid\": \"{{app_uuid}}\",\n  \"blocked_reason\": \"fraude reportado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 GET email bloqueado (true)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('blacklisted = true', () => pm.expect(b.blacklisted).to.be.true);",
              "pm.test('Trae el motivo', () => pm.expect(b.blocked_reason).to.eql('fraude reportado'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{email}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "{{email}}"
          ]
        },
        "description": "Consulta el email creado en la peticion 02 (prueba la persistencia en RDS)."
      }
    },
    {
      "name": "04 GET email no bloqueado (false)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('blacklisted = false', () => pm.expect(pm.response.json().blacklisted).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/no.existe.{{$timestamp}}@ejemplo.com",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "no.existe.{{$timestamp}}@ejemplo.com"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "05 POST sin email (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_uuid\": \"{{app_uuid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 POST motivo > 255 caracteres (400)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('motivo_largo', 'x'.repeat(256));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"largo@ejemplo.com\",\n  \"app_uuid\": \"{{app_uuid}}\",\n  \"blocked_reason\": \"{{motivo_largo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 GET sin token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{email}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "{{email}}"
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "08 POST token invalido (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"x@ejemplo.com\",\n  \"app_uuid\": \"{{app_uuid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "token-invalido",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "motivo_largo",
      "value": ""
    }
  ]
}